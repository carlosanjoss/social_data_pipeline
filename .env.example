# ── MongoDB ───────────────────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASSWORD=change_me
MONGO_DB=radar_odio
MONGO_PORT=27017
MONGO_URI=mongodb://admin:change_me@localhost:27017/radar_odio?authSource=admin

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=radar
POSTGRES_PASSWORD=change_me
POSTGRES_DB=radar_odio
POSTGRES_PORT=5432
POSTGRES_URI=postgresql://radar:change_me@localhost:5432/radar_odio

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URI=redis://localhost:6379/0

# ── Monitoramento ─────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me

# ── Caminhos dos scrapers (relativos à raiz do projeto) ───────────────
# Ajustar conforme a localização real dos scrapers
REDDIT_DATA_PATH=../../scrappers/reddit_scrapperv2academic/src/reddit_pipeline/data
# Fonte PostgreSQL adicional do projeto irmão ../reddit_pipeline.
# Se REDDIT_PIPELINE_URI ficar vazio, as credenciais serão lidas do .env dele.
REDDIT_PIPELINE_ENABLED=false
REDDIT_PIPELINE_URI=
REDDIT_PIPELINE_ENV_PATH=../reddit_pipeline/.env
TWITTER_DATA_PATH=../../scrappers/twitter_scrapper_project/data/json
YOUTUBE_DATA_PATH=../../scrappers/youtube_scrapper/data
FACEBOOK_DATA_PATH=../../scrappers/facebook_scrapper/data/output
INSTAGRAM_DATA_PATH=../../scrappers/instagram_scrapper/data
TIKTOK_DATA_PATH=../../scrappers/tiktok_scrapper/data
FAROL_EXPORTS_PATH=../farol_digital_json_api/exports

# ── Pipeline ──────────────────────────────────────────────────────────
BATCH_SIZE=100
LOG_LEVEL=INFO
TARGET_LANGUAGE=pt-BR
# Workers do pool de detecção de idioma na carga Postgres. Vazio = cpus-1.
# LOAD_WORKERS=8
